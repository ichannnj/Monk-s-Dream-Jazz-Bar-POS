PORT=3000

# ==========================================
# Supabase PostgreSQL Database (Cloud)
# ==========================================
# Connection Pooling (Port 6543) - Used for application runtime queries with PgBouncer / Supavisor
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Used for Prisma migrations & CLI introspection
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional Supabase API keys (for storage, auth webhooks, or Edge functions)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Hardware / Printer Simulation
# PRINTER_DEVICE="/dev/usb/receipt-printer"
