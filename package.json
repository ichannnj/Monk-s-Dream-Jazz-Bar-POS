{
  "name": "Monk's Dream Jazz Bar POS",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev",
    "build": "pnpm -F @monks/shared build && pnpm -F @monks/frontend build",
    "build:render": "bash scripts/render-build.sh",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:quiet": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:lint": "bash scripts/lint-migrations.sh",
    "db:types:check": "bash scripts/check-supabase-types.sh",
    "test": "node --experimental-strip-types scripts/test-core-processes.ts && node --experimental-strip-types packages/printing/src/index.test.ts",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:push": "npx supabase db push",
    "supabase:reset": "npx supabase db reset",
    "supabase:setup": "bash scripts/setup-supabase.sh",
    "supabase:setup:local": "bash scripts/setup-local-supabase.sh",
    "supabase:types": "npx supabase gen types typescript --linked > packages/shared/src/database.types.ts",
    "env:local": "cp frontend/.env.local frontend/.env && echo 'Switched frontend to Local Supabase environment'",
    "env:cloud": "cp frontend/.env.cloud frontend/.env && echo 'Switched frontend to Cloud Supabase environment'",
    "doppler:login": "doppler login",
    "doppler:setup": "doppler setup",
    "doppler:pull:dev": "doppler secrets download --no-file --format env > frontend/.env",
    "doppler:run": "doppler run -- turbo run dev",
    "sync:knowledge": "bash scripts/sync-knowledge.sh",
    "printer:daemon": "bash scripts/start-printer-daemon.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.11.2",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.2"
  }
}
